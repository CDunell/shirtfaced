# Read-only connection to the admin app's database, used only at build time
# by scripts/sync-products.mjs to refresh src/lib/products-data.generated.ts.
# Leave unset to build from the last-synced snapshot (checked into git).
SHOP_DATABASE_URL=postgresql://shirtfaced_readonly:changeme@127.0.0.1:55432/shirtfaced_shop

# Stripe. Test keys from https://dashboard.stripe.com/test/apikeys — the
# publishable key is NEXT_PUBLIC_ so it reaches the browser (that's what it's
# for); the secret key never should. Leave both unset and checkout shows the
# same honest "payment isn't connected" message it always did — see
# src/app/checkout/PaymentStep.tsx.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook's settings page once created — needed to verify a POST to
# /api/stripe-webhook actually came from Stripe, not just anyone who found
# the URL. See src/app/api/stripe-webhook/route.ts.
STRIPE_WEBHOOK_SECRET=

# This app has no direct database access (SHOP_DATABASE_URL above is
# read-only). Order creation and status updates go through admin's own
# /api/internal/orders instead — see src/app/api/create-payment-intent and
# src/app/api/stripe-webhook. ADMIN_INTERNAL_API_KEY must be the exact same
# value as INTERNAL_API_KEY in admin/.env.
ADMIN_API_URL=http://localhost:4200
ADMIN_INTERNAL_API_KEY=

# Analytics — social/paid attribution. Each is independent and NEXT_PUBLIC_
# so it reaches the browser; leave any of them unset and that platform's
# script simply never loads (see src/components/Analytics.tsx). Purchase
# events fire from src/lib/analytics.ts at both checkout completion paths.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
