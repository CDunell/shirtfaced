# Read-only connection to the admin app's database, used only at build time
# by scripts/sync-products.mjs to refresh src/lib/products-data.generated.ts.
# Leave unset to build from the last-synced snapshot (checked into git).
SHOP_DATABASE_URL=postgresql://shirtfaced_readonly:changeme@127.0.0.1:55432/shirtfaced_shop

# Runway developer API key used by scripts/image-to-video.mjs.
# Create this in the Runway developer portal. Never commit the real value.
RUNWAYML_API_SECRET=key_xxxxxxxxxxxxxxxxxxxxxxxx
