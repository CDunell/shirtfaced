# Postgres connection. Local dev points at the docker container started for
# Shirtfaced Studio (see ../studio/.env) — same instance, separate database.
# For Oracle Cloud, swap this for the provisioned instance's connection string;
# nothing else in the app needs to change.
SHOP_DATABASE_URL=postgresql://shirtfaced:shirtfaced@127.0.0.1:55432/shirtfaced_shop

# Single admin account. Generate a hash with:
#   node -e "require('./src/lib/password.ts')" (see admin/README.md)
ADMIN_EMAIL=admin@shirtfaced.wtf
ADMIN_PASSWORD_HASH=

# 32+ byte random secret used to sign the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Widens the session cookie so it also reaches Studio on its own subdomain.
# Studio verifies the same token with the same SESSION_SECRET, so one login
# covers both. Leave empty for localhost: a domain attribute there stops the
# cookie being stored at all.
SESSION_COOKIE_DOMAIN=.shirtfaced.wtf

# Where the "Studio" nav link points. Studio is its own application with its own
# database, the world documents and the OpenAI key; admin only links to it.
# Prompts are written there, not here.
STUDIO_URL=https://studio.shirtfaced.wtf

# Read-only connection to Studio's own database, same instance as
# SHOP_DATABASE_URL above, different database (see ../studio/.env). Used only
# by sync-approved-designs.ts to pull currently-approved designs in as draft
# products — nothing else in this app reads Studio's schema. Missing or
# unreachable is a no-op, same fallback behaviour as SHOP_DATABASE_URL in the
# storefront's sync scripts.
STUDIO_DATABASE_URL=postgresql://shirtfaced:shirtfaced@127.0.0.1:55432/shirtfaced_studio

