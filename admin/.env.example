# Postgres connection. Local dev points at the docker container started for
# Shirtfaced Studio (see ../studio/.env) — same instance, separate database.
# For Oracle Cloud, swap this for the provisioned instance's connection string;
# nothing else in the app needs to change.
SHOP_DATABASE_URL=postgresql://shirtfaced:shirtfaced@127.0.0.1:55432/shirtfaced_shop

# Single admin account. Generate a hash with:
#   node -e "require('./src/lib/password.ts')" (see admin/README.md)
ADMIN_EMAIL=admin@shirtfaced.wtf
ADMIN_PASSWORD_HASH=

# 32+ byte random secret used to sign the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the "Studio" nav link points. Studio has no deployed instance yet;
# this is a placeholder until it does.
STUDIO_URL=https://studio.shirtfaced.wtf
