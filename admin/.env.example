# Postgres connection. Local dev points at the docker container started for
# Shirtfaced Studio (see ../studio/.env) — same instance, separate database.
# For Oracle Cloud, swap this for the provisioned instance's connection string;
# nothing else in the app needs to change.
SHOP_DATABASE_URL=postgresql://shirtfaced:shirtfaced@127.0.0.1:55432/shirtfaced_shop

# Single admin account. Generate a hash with:
#   node -e "require('./src/lib/password.ts')" (see admin/README.md)
ADMIN_EMAIL=admin@shirtfaced.wtf
ADMIN_PASSWORD_HASH=

# 32+ byte random secret used to sign the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Widens the session cookie so it also reaches Studio on its own subdomain.
# Studio verifies the same token with the same SESSION_SECRET, so one login
# covers both. Leave empty for localhost: a domain attribute there stops the
# cookie being stored at all.
SESSION_COOKIE_DOMAIN=.shirtfaced.wtf

# Where the "Studio" nav link points. Studio is its own application with its own
# database, the world documents and the OpenAI key; admin only links to it.
# Prompts are written there, not here.
STUDIO_URL=https://studio.shirtfaced.wtf

# Read-only connection to Studio's own database, same instance as
# SHOP_DATABASE_URL above, different database (see ../studio/.env). Used only
# by sync-approved-designs.ts to pull currently-approved designs in as draft
# products — nothing else in this app reads Studio's schema. Missing or
# unreachable is a no-op, same fallback behaviour as SHOP_DATABASE_URL in the
# storefront's sync scripts.
STUDIO_DATABASE_URL=postgresql://shirtfaced:shirtfaced@127.0.0.1:55432/shirtfaced_studio

# Shared secret for the /api/internal/* routes the storefront's own server
# calls (order creation, order status updates from the Stripe webhook). The
# storefront's ADMIN_INTERNAL_API_KEY must be the exact same value.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Same Stripe account as the storefront's own STRIPE_SECRET_KEY (see the root
# .env.example) — used only for stripe.refunds.create() when staff cancel a
# paid/fulfilled order (see cancelOrder in src/db/store-queries.ts). Leave
# unset and cancelling a paid order fails loudly rather than silently
# cancelling without refunding.
STRIPE_SECRET_KEY=

# Resend (resend.com). Used to send the order-confirmation email once an
# order is marked paid — see markOrderPaid in src/db/store-queries.ts and
# src/lib/email.ts. Leave both unset and paid orders just don't get emailed;
# nothing crashes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Base URL for links inside emails this app sends that point back at the
# storefront (currently just the abandoned-cart email's "return to cart"
# link — see notifyAbandonedOrders in src/db/store-queries.ts). Defaults to
# the real domain if unset, so this only needs setting in local dev.
SITE_URL=

# Analytics page (src/app/analytics) — read-only reporting credentials, one
# set per platform, each independent. Leave any of them unset and that
# card just says so rather than erroring. Distinct from the storefront's
# pixel ids and Conversions/Events API tokens (see ../.env.example) — those
# only send events, they can't read anything back.

# GA4 Data API. GA4_PROPERTY_ID is the numeric property id (Admin → Property
# Settings in Google Analytics). The service account needs Viewer access on
# that property (Admin → Property Access Management) — create one in Google
# Cloud Console, enable the "Google Analytics Data API", download its JSON
# key, and set the two fields below from client_email and private_key.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# Meta Marketing API. META_AD_ACCOUNT_ID is the numeric id without the
# "act_" prefix. META_ADS_READ_ACCESS_TOKEN needs the ads_read permission —
# from Meta Events Manager → your Business → System Users, or a long-lived
# token from Graph API Explorer scoped to ads_read.
META_AD_ACCOUNT_ID=
META_ADS_READ_ACCESS_TOKEN=

# TikTok Marketing API. Both from TikTok Ads Manager → Assets → Advertiser
# ID, and a Marketing API app approved for reporting scope (business-api.
# tiktok.com/portal → your app → Generate Access Token).
TIKTOK_ADVERTISER_ID=
TIKTOK_ADS_READ_ACCESS_TOKEN=

