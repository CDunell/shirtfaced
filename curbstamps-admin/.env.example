# Postgres connection — its own database, separate from shirtfaced_shop and
# shirtfaced_studio (can live on the same Postgres instance/server; just a
# different database name). See docs/curbstamps/CURB_STAMPS_SPEC.md §4.
CURBSTAMPS_DATABASE_URL=postgresql://curbstamps:curbstamps@127.0.0.1:55432/curbstamps_shop

# Single admin account. Generate a hash with:
#   node -e "console.log(require('./src/lib/password').hashPassword('yourpassword'))"
# (run via `npx tsx -e "..."` since this isn't compiled)
ADMIN_EMAIL=admin@curbstamps.com.au
ADMIN_PASSWORD_HASH=

# 32+ byte random secret used to sign the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shared secret for the /api/internal/* routes curbstamps-site's own server
# calls (order creation, order status updates). Must be the exact same value
# as ADMIN_INTERNAL_API_KEY in curbstamps-site/.env.
INTERNAL_API_KEY=

# Same Stripe account as curbstamps-site's own STRIPE_SECRET_KEY — used only
# for stripe.refunds.create() when staff cancel a paid order.
STRIPE_SECRET_KEY=

# Print-on-demand. "mock" (or unset) is the only safe default — see
# src/lib/pod/index.ts. Set to "printful" only once PRINTFUL_API_KEY is set
# AND printful-adapter.ts's SYNC_VARIANT_MAP is filled in for real products —
# see that file's own comment.
POD_PROVIDER=mock
PRINTFUL_API_KEY=

# Shared secret the POD provider's webhook must send back (custom header —
# see app/api/pod/webhook/route.ts). Generate the same way as SESSION_SECRET.
POD_WEBHOOK_SECRET=
