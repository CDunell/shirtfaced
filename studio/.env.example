OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_REVIEW_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
OPENAI_TIMEOUT_SECONDS=180

# Google media rendering. Disabled by default; without both the switch and key,
# Studio stays planning-only and cannot spend on Nano/Veo.
GOOGLE_MEDIA_ENABLED=false
GEMINI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-preview
GOOGLE_IMAGE_SIZE=1K
GOOGLE_VIDEO_RESOLUTION=1080p
GOOGLE_VIDEO_POLL_SECONDS=10
GOOGLE_VIDEO_TIMEOUT_SECONDS=900

# Studio-side spend ceilings. Change deliberately for dev experiments; long-run
# production should ratchet these down after the benchmark establishes pass rates.
RENDERER_SCENE_BUDGET_USD=12
RENDERER_VALIDATION_BUDGET_USD=100
RENDERER_MONTHLY_BUDGET_USD=250
RENDERER_SEED_CANDIDATES=3
RENDERER_VIDEO_CANDIDATES=2

DATABASE_URL=postgresql+psycopg://shirtfaced_app:change-me@postgres-host:5432/shirtfaced_studio
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_SSLMODE=require

WORLDS_ROOT=./worlds
ASSETS_ROOT=./var/assets
ASSET_STORE=filesystem

WEB_DIST_ROOT=./web/dist

GIT_ENABLED=true
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

SOCIAL_PUBLISHING_ENABLED=false
SOCIAL_PUBLISHER_MODE=disabled
SOCIAL_MAX_ATTEMPTS=5
SOCIAL_RETRY_BASE_SECONDS=60

EMAIL_DELIVERY_ENABLED=false
EMAIL_ADAPTER_MODE=disabled
EMAIL_FROM_TRANSACTIONAL=orders@mail.shirtfaced.wtf
EMAIL_FROM_MARKETING=hello@news.shirtfaced.wtf
EMAIL_REPLY_TO=hello@shirtfaced.wtf
EMAIL_PREVIEW_ROOT=./var/email-previews

# Studio has no login of its own -- it verifies the same signed session cookie
# admin issues (see app/session_auth.py). Disabled by default so local dev
# stays login-free; production sets REQUIRE_SESSION_AUTH=true and
# SESSION_SECRET to the exact same value as admin/.env's SESSION_SECRET (the
# cookie is shared across both subdomains, so the secrets must match).
REQUIRE_SESSION_AUTH=false
SESSION_SECRET=
ADMIN_LOGIN_URL=https://admin.shirtfaced.wtf/login
