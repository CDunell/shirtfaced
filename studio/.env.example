OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_REVIEW_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
OPENAI_TIMEOUT_SECONDS=180

DATABASE_URL=postgresql+psycopg://shirtfaced_app:change-me@postgres-host:5432/shirtfaced_studio
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_SSLMODE=require

WORLDS_ROOT=./worlds
ASSETS_ROOT=./var/assets
ASSET_STORE=filesystem

GIT_ENABLED=true
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
