OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_REVIEW_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
OPENAI_TIMEOUT_SECONDS=180

DATABASE_URL=postgresql+psycopg://shirtfaced_app:change-me@postgres-host:5432/shirtfaced_studio
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_SSLMODE=require

WORLDS_ROOT=./worlds
ASSETS_ROOT=./var/assets
ASSET_STORE=filesystem

# Built Base Web interface. Run "npm run build" in web/ to produce it.
# In development the Vite dev server serves the interface instead.
WEB_DIST_ROOT=./web/dist

GIT_ENABLED=true
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Studio has no login of its own. Admin has one, and signs its session cookie
# with this secret; sharing the value means being signed into admin is being
# signed into Studio. Leave empty locally, where Studio is reachable only from
# this machine -- it starts unauthenticated and says so loudly. Set it on any
# deployment: this API spends money.
SESSION_SECRET=
LOGIN_URL=https://admin.shirtfaced.wtf/login

# Social publishing is off until platform credentials/adapters are connected.
SOCIAL_PUBLISHING_ENABLED=false
SOCIAL_PUBLISHER_MODE=disabled
SOCIAL_MAX_ATTEMPTS=5
SOCIAL_RETRY_BASE_SECONDS=60

# Email delivery is deliberately disabled until a provider and DNS are configured.
# `local` writes preview artifacts and is accepted only when DEBUG=true.
EMAIL_DELIVERY_ENABLED=false
EMAIL_ADAPTER_MODE=disabled
EMAIL_FROM_TRANSACTIONAL=orders@mail.shirtfaced.wtf
EMAIL_FROM_MARKETING=hello@news.shirtfaced.wtf
EMAIL_REPLY_TO=hello@shirtfaced.wtf
EMAIL_PREVIEW_ROOT=./var/email-previews
