{
  "name": "shirtfaced-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tailwind interface for Shirtfaced Studio",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "comments": {
    "react": "Was pinned to 18 only because Base Web 18.2.0 relied on defaultProps for function components, which React 19 removed (see docs/DECISIONS.md ADR-011). Base Web is gone as of the Tailwind migration (docs/ADMIN_STUDIO_UI_OVERHAUL_PLAN.md Phase 0) -- the pin is no longer load-bearing, but bumping to 19 is left as its own separate, deliberately-verified change rather than bundled into this cleanup."
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
