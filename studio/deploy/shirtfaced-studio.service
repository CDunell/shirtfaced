[Unit]
Description=Shirtfaced Studio
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/shirtfaced-studio
EnvironmentFile=/home/ubuntu/shirtfaced-studio/.env

# Bound to loopback on purpose. Admin reaches Studio from the same box, and this
# API spends money: the generate endpoint bills OpenAI and has no authentication
# of its own. Nothing but the box can reach it until a Cloudflare Access policy
# exists to stand in front.
#
# Host and port come from .env so there is one place to change them, and no way
# for the unit and the application to disagree about where Studio is listening.
ExecStart=/home/ubuntu/shirtfaced-studio/.venv/bin/uvicorn app.main:app \
    --host ${APP_HOST} --port ${APP_PORT}

Restart=on-failure
RestartSec=5

# The service writes canon Markdown and image assets under its own directory and
# needs nothing else on the box.
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
