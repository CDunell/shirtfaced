# Stripe. Test keys from https://dashboard.stripe.com/test/apikeys — the
# publishable key is NEXT_PUBLIC_ so it reaches the browser (that's what it's
# for); the secret key never should. Leave both unset and checkout shows the
# honest "payment isn't connected" message — see checkout/PaymentStep.tsx.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From the webhook's settings page in the Stripe dashboard once created —
# needed to verify a POST to /api/stripe-webhook actually came from Stripe.
STRIPE_WEBHOOK_SECRET=

# Printify — live catalog data (colours, sizes, prices, garment mockup
# photos) for the tee category on the shop grid and product pages. Get from
# Printify account settings → Connections → generate token. Leave unset and
# tee products fall back to the GarmentArt SVG stand-in, same as hoodie/cap
# (not built in Printify yet). See src/lib/printify.ts.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=28675131

# This app has no direct database access. Order creation and status updates
# go through curbstamps-admin's own /api/internal/orders instead — see
# api/create-payment-intent and api/stripe-webhook.
# ADMIN_INTERNAL_API_KEY must be the exact same value as INTERNAL_API_KEY in
# curbstamps-admin/.env.
ADMIN_API_URL=http://localhost:4300
ADMIN_INTERNAL_API_KEY=
